# .gitignore
# Ignore local Terraform state and lock files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.default.tfvars

# Ignore Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.env

# Ignore OS / IDE specific files
.DS_Store
Thumbs.db
.vscode/
.idea/
