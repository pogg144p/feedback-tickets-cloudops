# .gitignore
# Ignore AWS credentials CSV files and secrets
*.csv
*.pem
*.key
.env

# Ignore local Terraform state and lock files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.default.tfvars

# Ignore Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Ignore OS / IDE specific files
.DS_Store
Thumbs.db
.vscode/
.idea/
